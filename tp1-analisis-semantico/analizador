#!/usr/bin/env python3

import sys
import glob
import analizador_sintactico


def main():
    if len(sys.argv) < 2:
        print("Error. Uso correcto:")
        print(r"python3 ./analizador2 '.\BatSemánticos2023\Semánticos\Ej01*.PAS'")
        sys.exit(1)

    pattern = sys.argv[1]
    files = glob.glob(pattern)

    if not files:
        print(f"No se encontraron archivos para: {pattern}")
        sys.exit(1)

    for file_name in files:
        print(f"\nAnalizando: {file_name}")
        analizador_sintactico.read_source(file_name)


if __name__ == "__main__":
    main()